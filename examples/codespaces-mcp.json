{
  "inputs": [
    {
      "id": "context-control-api-key",
      "type": "promptString",
      "description": "Context Control API key with the MCP tools and scopes you need",
      "password": true
    }
  ],
  "servers": {
    "contextControl": {
      "type": "http",
      "url": "https://your-codespace-name-3000.app.github.dev/api/mcp/platform",
      "headers": {
        "Authorization": "Bearer ${input:context-control-api-key}"
      }
    }
  }
}